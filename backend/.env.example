# JasperLee 后端配置示例
# 复制为 backend/.env 并填入真实值。本文件不含真实密钥，可安全提交。
# 提示：backend/.env 已被 .dockerignore 排除，打包镜像时不会把密钥打进镜像。

# ---- 模型（OpenAI 兼容，默认智谱 GLM）----
# 值示例：glm | deepseek | mock   （mock 关闭真实模型）
MODEL_PROVIDER=glm
MODEL_API_KEY=<your-api-key>
MODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 默认模型（key 内全部可用模型会自动拉取并配进去，可在对话页切换）
MODEL_NAME=glm-4-flash
# 可选：显式指定可用模型列表（逗号分隔）；留空则启动时自动用 key 内全部模型
# MODEL_LIST=glm-4-flash,glm-4.5,glm-4.5-air
# 可选：本机 DNS 被污染连不上 open.bigmodel.cn 时，填直连 IP 绕过解析
# （例如 MODEL_HOST_IP=39.108.102.11，用 nslookup open.bigmodel.cn 8.8.8.8 获取最新 IP）
# MODEL_HOST_IP=

# ---- RAG ----------
# 值示例：glm | mock | local | aliyun
RAG_PROVIDER=glm
# 使用 aliyun 时需填写（DashVector / 百炼）
ALIYUN_API_KEY=
ALIYUN_ENDPOINT=

# ---- 管理员入口密码（默认 feng）----
ADMIN_PASSWORD=feng

# ---- PostgreSQL 连接（Docker 开发库）----
# 本机开发默认连 localhost:5432（docker compose up -d db）
# 容器内部署由 docker-compose.yml 的 environment 注入：PGHOST=db
PGHOST=localhost
PGPORT=5432
PGUSER=jasper
PGPASSWORD=jasper
PGDATABASE=jasper
# 也可以用一条 DATABASE_URL 代替上述 PG*（例如 postgres://jasper:jasper@localhost:5432/jasper）
# DATABASE_URL=postgres://jasper:jasper@localhost:5432/jasper

# ---- JasperKB 知识库（数字分身改博客）----
# 知识库服务地址（默认本机 8123）
KB_URL=http://localhost:8123
# 访问令牌（与 JasperKB 的 data/token.txt 一致）
KB_TOKEN=
